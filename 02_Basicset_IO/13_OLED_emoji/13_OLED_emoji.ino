#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h> //by Adafruit

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C

Adafruit_SSD1306 display(
  SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET
);

// 32x32 smile emoji bitmap
#define EMOJI_WIDTH 32
#define EMOJI_HEIGHT 32

const uint8_t PROGMEM emoji_bmp[] = {
  0b00000000, 0b00000011, 0b11000000, 0b00000000,
  0b00000000, 0b00011111, 0b11111000, 0b00000000,
  0b00000000, 0b01111100, 0b00111110, 0b00000000,
  0b00000000, 0b11100000, 0b00000111, 0b00000000,
  0b00000001, 0b10000000, 0b00000001, 0b10000000,
  0b00000011, 0b00000000, 0b00000000, 0b11000000,
  0b00000110, 0b00000000, 0b00000000, 0b01100000,
  0b00001100, 0b00000000, 0b00000000, 0b00110000,
  0b00011000, 0b00000000, 0b00000000, 0b00011000,
  0b00010000, 0b00000000, 0b00000000, 0b00001000,
  0b00110000, 0b00000000, 0b00000000, 0b00001100,
  0b00100000, 0b00000000, 0b00000000, 0b00000100,
  0b01100000, 0b00000000, 0b00000000, 0b00000110,
  0b01000000, 0b11100000, 0b00000111, 0b00000010,
  0b01000001, 0b00010000, 0b00001000, 0b10000010,
  0b11000010, 0b00001000, 0b00010000, 0b01000011,
  0b10000000, 0b00000000, 0b00000000, 0b00000001,
  0b10000000, 0b00000000, 0b00000000, 0b00000001,
  0b10000000, 0b00000000, 0b00000000, 0b00000001,
  0b10000000, 0b00000000, 0b00000000, 0b00000001,
  0b10000000, 0b00000000, 0b00000000, 0b00000001,
  0b10000000, 0b00000000, 0b00000000, 0b00000001,
  0b01000000, 0b00000000, 0b00000000, 0b00000010,
  0b01000000, 0b10000000, 0b00000001, 0b00000010,
  0b00100000, 0b01000000, 0b00000010, 0b00000100,
  0b00110000, 0b00100000, 0b00000100, 0b00001100,
  0b00011000, 0b00011000, 0b00011000, 0b00011000,
  0b00001100, 0b00000111, 0b11100000, 0b00110000,
  0b00000110, 0b00000000, 0b00000000, 0b01100000,
  0b00000011, 0b00000000, 0b00000000, 0b11000000,
  0b00000000, 0b11100000, 0b00000111, 0b00000000,
  0b00000000, 0b00011111, 0b11111000, 0b00000000
};


void setup() {
  Wire.begin(1, 3); //(SDA, SCL) 1,3:ConnectorA 5,4:ConnectorB

  if (!display.begin(
      SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    for (;;);
  }

  display.clearDisplay();

  // Draw emoji at center
  display.drawBitmap(
    (SCREEN_WIDTH - EMOJI_WIDTH) / 2,
    (SCREEN_HEIGHT - EMOJI_HEIGHT) / 2,
    emoji_bmp,
    EMOJI_WIDTH,
    EMOJI_HEIGHT,
    SSD1306_WHITE
  );

  display.display();
}

void loop() {
}
